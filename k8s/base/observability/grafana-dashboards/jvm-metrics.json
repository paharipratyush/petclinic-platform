{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "JVM metrics for Petclinic services — heap, GC, threads, CPU. Requires Micrometer JVM metrics (included in Spring Boot Actuator).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 1, "title": "Memory", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 2,
      "options": {"legend": {"calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (id) (jvm_memory_used_bytes{job=\"$service\",area=\"heap\"})", "legendFormat": "Heap Used — {{ id }}"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (id) (jvm_memory_committed_bytes{job=\"$service\",area=\"heap\"})", "legendFormat": "Heap Committed — {{ id }}"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (id) (jvm_memory_max_bytes{job=\"$service\",area=\"heap\"})", "legendFormat": "Heap Max — {{ id }}"}
      ],
      "title": "JVM Heap Memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "bytes"}, "overrides": []},
