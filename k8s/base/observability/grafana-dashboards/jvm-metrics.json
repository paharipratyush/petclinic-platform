      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (id) (jvm_memory_used_bytes{job=\"$service\",area=\"nonheap\"})", "legendFormat": "Non-Heap Used — {{ id }}"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (id) (jvm_memory_committed_bytes{job=\"$service\",area=\"nonheap\"})", "legendFormat": "Non-Heap Committed — {{ id }}"}
      ],
      "title": "JVM Non-Heap Memory",
      "type": "timeseries"
    },
