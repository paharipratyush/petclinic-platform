        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "rate(jvm_gc_pause_seconds_sum{job=\"$service\"}[5m])", "legendFormat": "GC Pause Rate — {{ action }} {{ cause }}"}
